# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alias runtime utilisés par l'image Docker générique. Dans docker-compose.yml ils sont
# dérivés automatiquement des deux variables NEXT_PUBLIC_* ci-dessus.
# SUPABASE_PUBLIC_URL=
# SUPABASE_ANON_KEY=

# Vérification JWT locale (docs/architecture/020-verification-jwt-locale.md) — trousseau
# de clés publiques du projet (le projet signe en ES256, pas HS256 : pas de secret
# partagé à renseigner). Nom générique (pas SUPABASE_JWKS_URL) : portable vers un futur
# backend self-hosté exposant le même type d'endpoint standard.
# Valeur : ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=

# Prisma — Project Settings > Database
# DATABASE_URL : pooled connection (port 6543, pgbouncer) pour le runtime applicatif —
#   rôle `app_runtime` (NOSUPERUSER, NOBYPASSRLS, ne possède pas les tables), réellement
#   soumis à RLS. Voir docs/architecture/014-decouplage-rls-auth-provider.md.
# DIRECT_URL   : connexion directe (port 5432) requise par `prisma migrate` — rôle
#   `postgres`, propriétaire des tables.
# ADMIN_DATABASE_URL : pooled (port 6543), même rôle privilégié que DIRECT_URL —
#   réservée à la résolution d'identité (lib/admin-prisma.ts). Ne jamais l'utiliser pour
#   une requête métier RLS-sensible.
DATABASE_URL=
ADMIN_DATABASE_URL=
DIRECT_URL=
