# -----------------------------------------------------------------------------
# Image locale construite depuis la branche client-deployment
# -----------------------------------------------------------------------------
# Ce tag identifie l'image construite sur le serveur.
SALUNI_VERSION=server

# 0.0.0.0 rend le service accessible depuis le réseau.
# Utiliser 127.0.0.1 si un reverse proxy HTTPS est installé sur le serveur.
SALUNI_BIND_ADDRESS=0.0.0.0
SALUNI_HTTP_PORT=80

# -----------------------------------------------------------------------------
# Supabase — Project Settings > API
# L'URL doit être publique et en HTTPS pour que le navigateur puisse s'authentifier.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clés publiques utilisées pour vérifier localement les JWT Supabase.
# Exemple : https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma — Supabase Project Settings > Database
#
# DATABASE_URL : connexion poolée avec le rôle app_runtime soumis aux règles RLS.
# ADMIN_DATABASE_URL : connexion poolée privilégiée réservée aux opérations système.
# DIRECT_URL : connexion directe privilégiée réservée aux migrations.
#
# Encoder les caractères spéciaux présents dans les mots de passe des URL.
# -----------------------------------------------------------------------------
DATABASE_URL=
ADMIN_DATABASE_URL=
DIRECT_URL=
