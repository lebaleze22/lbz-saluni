// Schema Prisma — Étape 1 (Registre d'activité)
// Voir docs/steps/Etape_01_Registre_Activite.md pour la spécification fonctionnelle
// et docs/architecture/ pour les décisions structurantes (tenant_id, RLS, montants XAF...).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenants — un salon = un tenant. Multi-tenant routing hors scope de l'Étape 1,
// mais tenant_id est posé dès la première table (cf. docs/architecture/001-*.md).
// ---------------------------------------------------------------------------
model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  users               User[]
  staff               Staff[]
  jobTitles           JobTitle[]
  staffJobTitles      StaffJobTitle[]
  clients             Client[]
  serviceCategories   ServiceCategory[]
  services            Service[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  payments            Payment[]
  expenses            Expense[]

  @@map("tenants")
}

enum UserRole {
  owner
  salon_admin
  manager
  staff

  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Users — comptes applicatifs, un-à-un avec auth.users (Supabase Auth).
// Pour l'Étape 1, seul salon_admin saisit des données ; manager/staff
// sont réservés pour une évolution future (cf. Etape_01_Registre_Activite.md).
// `owner` (cf. docs/architecture/012-role-owner.md) est un rôle de supervision
// globale au-dessus de salon_admin ("Director"), pas un rôle opérationnel — au
// plus un par tenant, provisionné par script comme le compte Director actuel.
// ---------------------------------------------------------------------------
model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // = auth.users.id (Supabase)
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String    @unique
  fullName  String    @map("full_name")
  role      UserRole  @default(salon_admin)
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("AppointmentCreatedBy")
  staffProfile Staff?

  @@unique([tenantId, id]) // cible de la FK composite staff(tenant_id, user_id) — cf. docs/architecture/013-job-title-vs-system-role.md
  @@index([tenantId])
  @@map("users")
}

enum StaffSystemRole {
  none
  director
  manager

  @@map("staff_system_role")
}

enum StaffPayType {
  fixed_salary
  commission

  @@map("staff_pay_type")
}

// ---------------------------------------------------------------------------
// Sex — enum partagé Staff/Client (cf. docs/architecture/015-staff-profil-et-postes-multiples.md).
// ---------------------------------------------------------------------------
enum Sex {
  homme
  femme

  @@map("sex")
}

// ---------------------------------------------------------------------------
// IdType — type de pièce d'identité présentée à l'embauche (Staff uniquement).
// ---------------------------------------------------------------------------
enum IdType {
  cni
  passeport

  @@map("id_type")
}

// ---------------------------------------------------------------------------
// JobTitle — intitulés de poste, propres à chaque salon (texte libre, pas un enum
// global). Gérée par l'Owner du tenant. Purement un libellé métier/affichage :
// n'accorde AUCUNE permission — voir Staff.systemRole ci-dessous et
// docs/architecture/013-job-title-vs-system-role.md pour la séparation délibérée.
// ---------------------------------------------------------------------------
model JobTitle {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffJobTitles StaffJobTitle[]

  @@unique([tenantId, id]) // cible de la FK composite staff_job_titles(tenant_id, job_title_id)
  @@index([tenantId])
  @@map("job_titles")
}

// ---------------------------------------------------------------------------
// Staff — membres de l'équipe réalisant les prestations.
//
// `systemRole` (enum fermé, contrôlé en code) est ce qui détermine l'éligibilité à
// un compte de connexion : `userId` ne doit être renseigné que si systemRole != none
// (contrainte CHECK en base, non modélisable par Prisma — voir la migration RLS
// dédiée et docs/architecture/013-job-title-vs-system-role.md).
//
// `idNumber` est une donnée sensible (pièce d'identité) — voir
// docs/architecture/015-staff-profil-et-postes-multiples.md pour la recommandation de
// chiffrement au repos et la règle "jamais dans un SELECT de sélecteur applicatif".
// ---------------------------------------------------------------------------
model Staff {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  name              String
  sex               Sex?
  phone             String?
  residence         String?
  idType            IdType?         @map("id_type")
  idNumber          String?         @map("id_number")
  yearsOfExperience Int?            @map("years_of_experience")
  systemRole        StaffSystemRole @default(none) @map("system_role")
  userId            String?         @unique @map("user_id") @db.Uuid
  payType           StaffPayType?   @map("pay_type")
  fixedSalary       Int?            @map("fixed_salary") // FCFA mensuels lorsque payType = fixed_salary
  commissionRate    Decimal?        @map("commission_rate") @db.Decimal(5, 2) // % réservé pour calcul futur des commissions
  active            Boolean         @default(true)
  isDeleted         Boolean         @default(false) @map("is_deleted")
  deletedAt         DateTime?       @map("deleted_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  appointments     Appointment[]
  jobTitles        StaffJobTitle[]
  recordedExpenses Expense[]

  @@unique([tenantId, id]) // cible de la FK composite staff_job_titles(tenant_id, staff_id)
  @@unique([tenantId, userId]) // requis par Prisma pour la relation 1-1 composite vers User ; userId seul est déjà @unique
  @@index([tenantId])
  @@index([tenantId, systemRole])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// StaffJobTitle — relation many-to-many Staff <-> JobTitle : un staff peut occuper
// plusieurs postes. `isPrimary` désigne le poste principal (au plus un par staff,
// index unique partiel) — voir docs/architecture/015-staff-profil-et-postes-multiples.md
// pour pourquoi ce champ existe et comment il doit être utilisé.
//
// Table de liaison pure (pas de isDeleted/active/deletedAt, à la différence des tables
// métier principales) : retirer un poste à un staff est un DELETE réel de la ligne de
// liaison, pas une suppression logique — la ligne n'a aucune valeur d'audit isolée en
// dehors de l'association qu'elle représente.
// ---------------------------------------------------------------------------
model StaffJobTitle {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  staffId    String  @map("staff_id") @db.Uuid
  jobTitleId String  @map("job_title_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  jobTitle JobTitle @relation(fields: [tenantId, jobTitleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([staffId, jobTitleId]) // un staff ne peut pas se voir assigner deux fois le même poste
  @@index([tenantId])
  @@index([tenantId, staffId])
  @@map("staff_job_titles")
}

// ---------------------------------------------------------------------------
// Clients — saisie à la volée, dédoublonnage best-effort par nom (cf. spec).
// ---------------------------------------------------------------------------
model Client {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  phone     String?
  sex       Sex? // optionnel : cohérent avec la saisie rapide sans friction pour les clients
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Services — catalogue de prestations du salon, prix de référence.
// Le prix effectif d'une visite est capturé ligne par ligne dans
// AppointmentService (cf. spec : "chacun avec son propre prix").
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// ServiceCategory — regroupement des prestations, propre à chaque salon (texte
// libre, pas un enum global) — même pattern que JobTitle
// (docs/architecture/013-job-title-vs-system-role.md). Gérée par l'Owner du tenant.
// Aucune valeur imposée globalement : chaque tenant construit sa propre liste.
// Voir docs/architecture/016-catalogue-prestations-caprice.md.
// ---------------------------------------------------------------------------
model ServiceCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, id]) // cible de la FK composite services(tenant_id, category_id)
  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  categoryId   String?   @map("category_id") @db.Uuid
  defaultPrice Int       @map("default_price") // FCFA, entier — voir docs/architecture/002-montants-xaf.md
  active       Boolean   @default(true)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            ServiceCategory?     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  appointmentServices AppointmentService[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("services")
}

enum AppointmentSource {
  reservation
  walk_in

  @@map("appointment_source")
}

// ---------------------------------------------------------------------------
// Appointments — une visite = un enregistrement du registre.
// ---------------------------------------------------------------------------
model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  staffId     String            @map("staff_id") @db.Uuid
  createdById String            @map("created_by") @db.Uuid
  source      AppointmentSource
  startTime   DateTime          @map("start_time")
  active      Boolean           @default(true)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  staff               Staff                @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  createdBy           User                 @relation("AppointmentCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  appointmentServices AppointmentService[]
  payments            Payment[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([tenantId, staffId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// AppointmentServices — lignes de prestation d'une visite, prix indépendant
// par ligne (permet les rapports par type de prestation).
// tenant_id dénormalisé ici pour des policies RLS directes, sans jointure
// (cf. docs/architecture/001-tenant-id-rls.md).
// ---------------------------------------------------------------------------
model AppointmentService {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  price         Int // FCFA, entier — prix de cette ligne au moment de la visite
  active        Boolean   @default(true)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([appointmentId])
  @@map("appointment_services")
}

enum PaymentMethod {
  cash
  orange_money
  mtn_momo

  @@map("payment_method")
}

// ---------------------------------------------------------------------------
// Payments — règlement d'une visite. Montant total = somme des lignes de
// service (cf. spec). Pas de paiement en ligne à cette étape : Mobile Money
// est ici une méthode déclarative saisie manuellement, pas une intégration
// d'agrégateur (cf. docs/architecture/003-mobile-money.md).
// ---------------------------------------------------------------------------
model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  appointmentId String        @map("appointment_id") @db.Uuid
  amount        Int // FCFA, entier
  method        PaymentMethod
  active        Boolean       @default(true)
  isDeleted     Boolean       @default(false) @map("is_deleted")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Expenses — suivi des dépenses du salon (loyer, fournitures, salaires...).
// Indépendant du registre d'activité (Appointment/Payment) : une dépense n'est
// rattachée à aucune visite, seulement au tenant et à qui l'a enregistrée.
// `category` est un texte libre (pas de table de référence comme ServiceCategory/
// JobTitle) : la mission ne demande pas de liste gérée par tenant pour ce champ.
// Voir docs/architecture/019-suivi-des-depenses.md.
// ---------------------------------------------------------------------------
model Expense {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  description  String
  amount       Int // FCFA, entier — même convention que Service.defaultPrice/Payment.amount
  category     String?
  recordedById String    @map("recorded_by") @db.Uuid
  occurredAt   DateTime  @map("occurred_at")
  active       Boolean   @default(true)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy Staff  @relation(fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, occurredAt])
  @@map("expenses")
}
