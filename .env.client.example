# Images de release publiées par GitHub Actions (publiques ou accessibles après docker login).
SALUNI_IMAGE_ROOT=ghcr.io/lebaleze22/lbz-saluni
SALUNI_VERSION=edge

# Générés automatiquement par scripts/client-install/install-macos.sh.
LOCAL_POSTGRES_PASSWORD=
LOCAL_APP_RUNTIME_PASSWORD=
GOTRUE_JWT_SECRET=
AUTH_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Installation strictement limitée au Mac lui-même.
LOCAL_HTTP_PORT=54321
LOCAL_PUBLIC_URL=http://localhost:54321
